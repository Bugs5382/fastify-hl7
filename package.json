{
  "name": "fastify-hl7",
  "version": "3.3.0",
  "description": "A Fastify HL7 Plugin Developed in Pure TypeScript.",
  "type": "module",
  "module": "./dist/index.mjs",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.15.0"
  },
  "scripts": {
    "clean": "rm -rf coverage docs dist temp",
    "build": "tsdown && tsc --emitDeclarationOnly",
    "build:watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "vitest run",
    "test:verbose": "vitest run --reporter verbose",
    "test:watch": "vitest watch",
    "test:coverage": "vitest --coverage",
    "typedoc": "typedoc",
    "typedoc:watch": "typedoc -watch",
    "update": "npx npm-check-updates -u --enginesNode && npm run update:post-update",
    "update:post-update": "npm install && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bugs5382/fastify-hl7.git"
  },
  "keywords": [
    "node-hl7-client",
    "node-hl7-server",
    "hl7",
    "fastify",
    "fastify-plugin"
  ],
  "author": "Shane Froebel",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Bugs5382/fastify-hl7/issues"
  },
  "homepage": "https://github.com/Bugs5382/fastify-hl7#readme",
  "dependencies": {
    "@fastify/error": "^4.1.0",
    "fastify-plugin": "^5.0.1",
    "node-hl7-client": "^4.0.0",
    "node-hl7-server": "^4.0.0"
  },
  "devDependencies": {
    "@the-rabbit-hole/eslint-config": "^0.4.0",
    "@types/node": "^22.13.11",
    "@types/tcp-port-used": "^1.0.4",
    "@vitest/coverage-v8": "^3.0.9",
    "@vitest/ui": "^3.0.9",
    "eslint": "^9.39.4",
    "fastify": "^5.2.1",
    "npm-check-updates": "^17.1.14",
    "portfinder": "^1.0.35",
    "pre-commit": "^1.2.2",
    "prettier": "^3.8.3",
    "tcp-port-used": "^1.0.2",
    "tsd": "^0.31.2",
    "tsdown": "^0.22.0",
    "typedoc": "^0.28.1",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "precommit": [
    "lint:fix",
    "build"
  ]
}
